# 统一行尾策略，避免 CRLF 破坏 shell 脚本
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.csv text eol=lf

# Windows 批处理必须用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制
*.jpg binary
*.png binary
*.onnx binary
*.arrow binary
*.db binary
